# RUCKUS One API application (Admin > Account Management > API Keys)
R1_TENANT_ID=
R1_CLIENT_ID=
R1_CLIENT_SECRET=
# Region: https://api.ruckus.cloud (NA), https://api.eu.ruckus.cloud, https://api.asia.ruckus.cloud
R1_API_BASE=https://api.ruckus.cloud
R1_OAUTH_BASE=https://api.ruckus.cloud

PORT=8080
POLL_SECONDS=60
# Optional: require ?key=... on the viewer URL (kiosk browsers)
NOC_VIEW_KEY=
# Optional: allow the /admin editor from non-localhost with ?key=...
NOC_ADMIN_KEY=
# NOC_DEMO=1 serves synthetic data (no R1 credentials needed)
NOC_DATA_DIR=/path  # optional: keep settings/layout/history somewhere else
