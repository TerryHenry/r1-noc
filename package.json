{
  "name": "r1-noc",
  "version": "0.4.0",
  "description": "R1 NOC Wall — server-side NOC display for RUCKUS One. Polls the public R1 API and serves a customizable wall dashboard to any browser.",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "NOC_DEMO=1 node server.js",
    "demo:msp": "NOC_DEMO=1 NOC_DEMO_MSP=1 node server.js",
    "package": "node scripts/package.js",
    "upgrade": "node scripts/upgrade.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerryHenry/r1-noc.git"
  },
  "homepage": "https://github.com/TerryHenry/r1-noc#readme",
  "bugs": {
    "url": "https://github.com/TerryHenry/r1-noc/issues"
  },
  "keywords": [
    "ruckus",
    "ruckus-one",
    "noc",
    "dashboard",
    "msp",
    "wifi",
    "switching"
  ],
