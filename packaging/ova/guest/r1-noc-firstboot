#!/bin/bash
# Runs once, on the first boot of a new appliance copy.
set -euo pipefail
ENV=/etc/r1-noc.env; DATA=/var/lib/r1-noc
ssh-keygen -A >/dev/null 2>&1 || true
if [ ! -f "$ENV" ]; then
  umask 027
  KEY=$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 22)
  printf 'NOC_ADMIN_KEY=%s\n' "$KEY" > "$ENV"; chgrp r1noc "$ENV"
fi
r1-noc-cert || echo "certificate generation failed — HTTPS can be set up later in the editor"
touch "$DATA/.provisioned"; chown r1noc:r1noc "$DATA/.provisioned"
/usr/local/sbin/r1-noc-banner || true
