[Unit]
Description=R1 NOC Wall
After=network-online.target r1-noc-firstboot.service
Wants=network-online.target
Requires=r1-noc-firstboot.service

[Service]
User=r1noc
Group=r1noc
WorkingDirectory=/opt/r1-noc
EnvironmentFile=-/etc/r1-noc.env
Environment=PORT=80 NOC_DATA_DIR=/var/lib/r1-noc NOC_SUPERVISED=1
ExecStart=/usr/local/bin/node /opt/r1-noc/server.js
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
